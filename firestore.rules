rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------- users/{userId} ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user';
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- services/{serviceId} ----------
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- laundryItems/{itemId} ----------
    match /laundryItems/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- detergents/{detergentId} ----------
    match /detergents/{detergentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- orders/{orderId} ----------
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- counters/{counterId} ----------            <-- NEW
    // Backs OrderDatasource.nextOrderSequence's atomic order-number
    // allocation (counters/orders_{YYYYMMDD}). Contains nothing but a
    // running integer — no order/customer data — so any signed-in
    // user may read/write it. Without this rule, Firestore's default
    // deny-all applies and every order creation fails with
    // permission-denied inside the transaction.
    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // ---------- notifications/{notificationId} ----------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---------- promos/{promoId} ----------
    match /promos/{promoId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}