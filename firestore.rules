rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------- users/{userId} ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user';

      // SECURITY FIX — the previous rule (`isOwner(userId) || isAdmin()`)
      // let any signed-in user promote themselves to admin by writing
      // `role: 'admin'` to their own document (isOwner() only checks who
      // owns the doc, not what fields are being changed). An admin may
      // still change anyone's role; a non-admin owner may update their
      // own document but may NOT change `role` — it must stay whatever
      // it already was.
      allow update: if isAdmin() ||
        (isOwner(userId) && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ---------- services/{serviceId} ----------
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // ---------- services/{serviceId}/items/{itemId} ----------
      // Per-garment catalog for itemized services (Dry Cleaning,
      // Wash & Ironing) — read by ServiceItemDatasource.getActiveItems,
      // seeded/edited by ServiceItemRepository. Subcollections do NOT
      // inherit the parent match block above, so without this nested
      // rule every read/write here falls through to Firestore's
      // default-deny and fails with permission-denied — for admins
      // and regular customers alike.
      match /items/{itemId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    // ---------- laundryItems/{itemId} ----------
    match /laundryItems/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- detergents/{detergentId} ----------
    match /detergents/{detergentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- orders/{orderId} ----------
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // SECURITY FIX — the previous rule only checked ownership, so a
      // client could forge `status` (e.g. create an order as
      // 'completed', skipping the whole received/washing/drying/ready
      // pipeline) or write an arbitrary/negative `total`/`subtotal`.
      // `OrderRepository.createOrder` always creates an order as
      // `status: 'pending'` with non-negative totals — this rule now
      // enforces that a client can't create anything else. It does not
      // (and can't, from rules alone) re-verify that `total` matches
      // what `PriceCalculator` would have computed — that level of
      // trust requires server-side computation (e.g. a Cloud Function),
      // not Firestore rules.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.subtotal is number &&
        request.resource.data.subtotal >= 0;

      // PART 3 (Order Details → Change Address) — an admin may still
      // update anything (status transitions, etc., per
      // OrderRepository.updateOrderStatus). A regular customer gets
      // one narrow extra permission on top of "no update at all":
      // they may update ONLY the pickup-address snapshot fields on an
      // order that is (a) their own, (b) a Pickup order, and (c)
      // still `pending` — exactly the same `isAddressEditable` rule
      // `OrderRepository.updateOrderAddress` already enforces in Dart
      // — so this mirrors that check server-side rather than trusting
      // the client alone. `diff(resource.data).affectedKeys()
      // .hasOnly([...])` is what actually blocks a customer from
      // sneaking in a status/pricing/`userId` change alongside an
      // address update: any written field outside this exact list
      // (including `status` or `userId` themselves) makes the whole
      // write fail.
      allow update: if isAdmin() ||
        (isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          resource.data.method == 'pickup' &&
          resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'address',
            'pickupPhone',
            'pickupFullName',
            'pickupStreetAddress',
            'pickupRegionName',
            'pickupProvinceName',
            'pickupCityName',
            'pickupBarangayName',
            'pickupPostalCode',
            'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    // ---------- counters/{counterId} ----------
    // Backs OrderDatasource.nextOrderSequence's atomic order-number
    // allocation (counters/orders_{YYYYMMDD}). Contains nothing but a
    // running integer — no order/customer data.
    //
    // SECURITY FIX — the previous rule (`allow read, write: if
    // isSignedIn()`) let any signed-in user overwrite this document
    // with an arbitrary value (e.g. reset it to 0, causing today's
    // order numbers to collide with existing ones, or jump it far
    // ahead). `nextOrderSequence`'s transaction always writes exactly
    // `{lastSequence: <previous value + 1>}` — this rule now enforces
    // that shape and that increment, so the counter can still be
    // advanced by any customer's checkout (which is required — see
    // the datasource's doc comment on why this can't be admin-only)
    // but can no longer be set to an arbitrary number.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['lastSequence']) &&
        request.resource.data.lastSequence is number &&
        request.resource.data.lastSequence ==
          (resource == null ? 1 : resource.data.lastSequence + 1);
    }

    // ---------- notifications/{notificationId} ----------
    // One shared collection for both customer and admin notifications
    // — an admin notification is just a NotificationModel document
    // whose `userId` happens to be the signed-in admin's own uid (see
    // NotificationService.notifyAdminOrderCreated/notifyAdminOrderReady
    // and AdminDashboard's `_startAdminOrderWatch`), not a different
    // collection or a different rule shape.
    //
    // SECURITY FIX — the previous rule OR'd in `isAdmin()` on read,
    // update, and delete, which let any admin read/edit/erase *any*
    // customer's private notifications, not just their own. Nothing in
    // the app ever needs that: every query in NotificationService
    // (getUserNotifications, streamUserNotifications, markAsRead) is
    // filtered to `userId == <the signed-in caller's own uid>`,
    // customer or admin alike, so `isAdmin()` here was pure unused
    // attack surface, not a real requirement. Ownership by
    // `resource.data.userId` is now the only path to read/update/
    // delete a notification, for both roles.
    match /notifications/{notificationId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      // SECURITY FIX — `allow update` previously had no field-level
      // check at all, so the owner of a notification (customer or
      // admin) could rewrite `title`/`message`/`type`/`orderId`/
      // `userId` on their own document, not just flip `isRead`.
      // NotificationService.markAsRead only ever sends
      // `{'isRead': true}` — this rule now enforces that an update can
      // touch `isRead` and nothing else, so "mark as read" is the only
      // update this collection's owner can actually perform.
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    // ---------- promos/{promoId} ----------
    // Backs PromoDatasource/PromoRepository — the redeemable promo
    // codes shown on OffersScreen and managed on ManagePromosScreen
    // (PART 18A/18B). Any signed-in user can read, only admins can
    // create/update/delete promo documents.
    match /promos/{promoId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- offers/{offerId} ----------
    // Backs OfferService.streamActiveOffers (the "Current Offers"
    // carousel on the dashboard/offer_card.dart). This collection is
    // distinct from promos/{promoId} above — same read/write shape,
    // but a separate collection entirely.
    //
    // BUG FIX — this collection previously had no match block at all,
    // so every read fell through to Firestore's default-deny and
    // failed with permission-denied, regardless of auth state. That
    // was the actual cause of the "Current Offers" section silently
    // failing to load (see the now-removed debug logging in
    // offer_card.dart).
    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
